    },
    {
      "durationInSeconds": 22.5,
      "heading": "Search & Discover \u2013 The 1,000+ Occupation Index",
      "kpiData": null,
      "sceneId": "scene_2",
      "subheading": null,
      "tableData": null,
      "type": "video_clip",
      "voiceoverScript": "Welcome to the AI Career Radar. Start by searching over one thousand standardized occupations pulled directly from the official O*NET database.\n\nImmediately, the radar maps your career's task distribution. Hover over the interactive donut chart to see exactly how much of your day is dedicated to High, Medium, or Low-risk activities.",
      "visualAssetUrl": "http://localhost:5001/api/v1/video/static/uploads/custom_1784391515_8cf21216db8c4deea744c6516a34bf5f.mp4",
      "audioDuration": 22.0,
      "durationInFrames": 1350
    },
    {
      "durationInSeconds": 21.06,
      "heading": "The Upskilling Simulator \u2013 Shifting the Scale",
      "kpiData": null,
      "sceneId": "scene_3",
      "subheading": null,
      "tableData": null,
      "type": "video_clip",
      "voiceoverScript": "Here's where it gets powerful. You aren't stuck with your default score. Under the Upskilling Simulator, grab the sliders to adjust your daily focus.\n\nIf you automate routine data administration and shift your time toward complex strategy, team leadership, or creative problem-solving, watch your AI Vulnerability score drop in real-time.",
