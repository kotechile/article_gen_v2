      "heading": "Is Your Career AI-Resistant?",
      "kpiData": null,
      "sceneId": "scene_1",
      "subheading": "The Problem",
      "tableData": null,
      "type": "video_clip",
      "voiceoverScript": "We've all seen the headlines. AI is changing everything. But how does it affect your daily grind? The truth is, AI doesn't automate entire jobs\u2014it automates specific tasks.",
      "visualAssetUrl": "http://localhost:5001/api/v1/video/static/uploads/custom_1784391506_5081a235355740f89acfda693e748e91.mp4",
      "audioDuration": 11.12,
