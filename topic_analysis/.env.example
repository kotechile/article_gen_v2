# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Backend Security
SECRET_KEY=your-very-secure-secret-key
# DATABASE_URL is optional if using Supabase client exclusively, but good to have if using SQLAlchemy
DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend Build Vars (Must be set for Docker build)
NEXT_PUBLIC_API_KEY=your-api-key
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_KEY=your-secure-api-key-must-match-frontend
